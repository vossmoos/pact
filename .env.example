# Copy to .env (never commit it) and fill in what you use.
# Only PACT_* variables reach the running container; SCW_*/DEPLOY_* are read by deploy.sh.

# ============================================================== Sources
# PACT_SOURCE__<NAME>__<SETTING>. The lowercased NAME becomes the source name, the first
# part of every tool (zendesk_get_ticket), label (zendesk:ticket:read) and role
# (zendesk:reader). TYPE picks the pack and defaults to NAME. Remove a block to disable it.

# Zendesk
PACT_SOURCE__ZENDESK__DOMAIN=acme.zendesk.com
PACT_SOURCE__ZENDESK__API_KEY=
# PACT_SOURCE__ZENDESK__TIMEOUT=30

# Jira Cloud
PACT_SOURCE__JIRA__SITE=acme.atlassian.net
PACT_SOURCE__JIRA__EMAIL=bot@acme.com
PACT_SOURCE__JIRA__API_TOKEN=
# Optional: confine every Jira tool to these projects
# PACT_SOURCE__JIRA__PROJECTS=OPS,SUP

# Wrike
PACT_SOURCE__WRIKE__TOKEN=
# EU data centre accounts:
# PACT_SOURCE__WRIKE__BASE_URL=https://app-eu.wrike.com/api/v4

# A second Zendesk account, published as support_eu_* tools and support_eu:* roles:
# PACT_SOURCE__SUPPORT_EU__TYPE=zendesk
# PACT_SOURCE__SUPPORT_EU__DOMAIN=acme-eu.zendesk.com
# PACT_SOURCE__SUPPORT_EU__API_KEY=

# ============================================================== Agent keys
# PACT_AGENT__<NAME>__KEY. Agent "support-bot" -> PACT_AGENT__SUPPORT_BOT__KEY.
# Each key needs a matching config/agents/<name>.yaml; without one it sees no tools.
# deploy.sh generates the default key when this line is missing or empty.
PACT_AGENT__DEFAULT__KEY=
# PACT_AGENT__SUPPORT_BOT__KEY=

# ============================================================== Users (optional)
# Validate forwarded SSO tokens (X-Pact-User-Token header). Without these, a forwarded
# token is rejected. Calls without a token run as the agent's service user (users.yaml),
# else as the built-in "anonymous" user, which has no roles in the example config.
# PACT_OIDC__ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# PACT_OIDC__AUDIENCE=api://pact
# PACT_OIDC__JWKS_URL=          # default: read from the issuer's discovery document

# ============================================================== Runtime (optional)
# PACT_CONFIG_DIR=config        # the container uses /config
# PACT_PORT=8080
# PACT_MCP_PATH=/mcp
# PACT_RELOAD_SECONDS=10        # 0 disables hot reload of the config folder
# PACT_AUDIT_FILE=              # JSON lines; stdout always gets them too
# PACT_LOG_LEVEL=INFO
# PACT_PLUGINS=acme_crm         # extra connector modules to import (comma-separated)
# PACT_USER_TOKEN_HEADER=X-Pact-User-Token
# PACT_STATELESS_HTTP=false     # true to run several replicas without sticky sessions

# ============================================================== Scaleway deploy (deploy.sh)
# IAM -> API keys: the *secret* key (UUID), not the access key (SCW...).
SCW_SECRET_KEY=
SCW_REGION=fr-par
SCW_REGISTRY_NAMESPACE=pact
# Kapsule cluster id; deploy.sh installs its kubeconfig with the scw CLI. Leave empty to
# use the current kubectl context (or set DEPLOY_KUBE_CONTEXT).
SCW_K8S_CLUSTER_ID=
# DEPLOY_KUBE_CONTEXT=

DEPLOY_NAMESPACE=pact
DEPLOY_RELEASE=pact
# Public hostname; needs an ingress controller and cert-manager in the cluster.
# Leave empty to keep Pact cluster-internal (port-forward).
DEPLOY_HOST=
# DEPLOY_INGRESS_CLASS=nginx
# DEPLOY_CLUSTER_ISSUER=letsencrypt-prod

# Permissions source. Default: ./config shipped as a ConfigMap on every deploy.
# Or keep permissions in their own Git repo, synced by a git-sync sidecar:
# DEPLOY_GIT_REPO=https://github.com/acme/pact-config.git
# DEPLOY_GIT_REF=main
# DEPLOY_GIT_PATH=tenants/acme      # folder holding agents/, users.yaml, domains.yaml
# DEPLOY_GIT_SECRET=pact-git        # Secret with GITSYNC_USERNAME / GITSYNC_PASSWORD
